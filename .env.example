# Explicit local server example. No .env file is loaded automatically by Sentry.
# The run command accepts --env-file .env to read only its configured API key.
# Set the exact identifier served by your endpoint.
SENTRY_PROVIDER=openai_compatible
SENTRY_API_BASE=http://localhost:8000/v1
SENTRY_MODEL=Qwen3.5-9B
SENTRY_JSON_MODE=native
SENTRY_TIMEOUT=120
SENTRY_MAX_RETRIES=0

# Empty is valid for an unauthenticated local compatible server.
SENTRY_API_KEY=
# Optional: name an existing environment variable instead of SENTRY_API_KEY.
# SENTRY_API_KEY_ENV=TOGETHER_API_KEY

# Native provider defaults; set only those required by your chosen provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# Hosted-provider examples need the exact model available in your account.
# For Anthropic set SENTRY_PROVIDER=anthropic and SENTRY_JSON_MODE=prompt.
# Remove SENTRY_API_BASE to use a native provider's default endpoint.

# OpenRouter: configs/providers/openrouter.yaml uses this credential variable.
OPENROUTER_API_KEY=
# Environment-only setup: set SENTRY_PROVIDER=openrouter, remove SENTRY_API_BASE,
# and set SENTRY_MODEL=qwen/qwen3.5-9b. Explicitly disable reasoning for the smoke:
# SENTRY_REASONING_ENABLED=false
# Leave SENTRY_REASONING_ENABLED unset for providers other than openrouter.
